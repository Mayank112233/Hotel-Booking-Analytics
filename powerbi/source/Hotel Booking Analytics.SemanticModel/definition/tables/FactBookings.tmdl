table FactBookings
	lineageTag: 19af8b34-7d4a-5cd5-80c2-99fd9beab1d6

	measure 'Total Bookings' = DISTINCTCOUNT(FactBookings[booking_id])
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 0a312e53-6cf2-42f5-b360-f32e6ba2b711

	measure 'Completed Bookings' = CALCULATE([Total Bookings], KEEPFILTERS(FactBookings[booking_status] = "Completed"))
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 4087d9bb-b823-43c2-a673-7abddbfd4679

	measure 'Cancelled Bookings' = CALCULATE([Total Bookings], KEEPFILTERS(FactBookings[booking_status] = "Cancelled"))
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 901a181f-7008-4cc5-b9a5-ee6a0773558e

	measure 'Total Revenue' = DIVIDE(SUM(FactBookings[revenue_cents]), 100)
		formatString: #,0.00 " CU"
		displayFolder: KPIs
		lineageTag: e99104ea-0292-4760-8b82-8c43fc252d01

	measure 'Total Profit' = DIVIDE(SUM(FactBookings[profit_cents]), 100)
		formatString: #,0.00 " CU"
		displayFolder: KPIs
		lineageTag: 015c7575-190e-4563-be8e-559d3191642b

	measure 'Average Booking Value' = DIVIDE([Total Revenue], [Completed Bookings])
		formatString: #,0.00 " CU"
		displayFolder: KPIs
		lineageTag: 82930718-6ac9-4acf-96fa-f42c8afbdeaf

	measure 'Cancellation Rate' = DIVIDE([Cancelled Bookings], [Total Bookings])
		formatString: 0.00%
		displayFolder: KPIs
		lineageTag: bba694f5-c24c-4244-86d9-923eb4111518

	measure 'Profit Margin' = DIVIDE([Total Profit], [Total Revenue])
		formatString: 0.00%
		displayFolder: KPIs
		lineageTag: 4c4f272b-014d-46ce-9c28-73b52f6475ed

	measure 'Occupied Room Nights' = CALCULATE(SUM(FactBookings[number_of_nights]), KEEPFILTERS(FactBookings[booking_status] = "Completed"))
		formatString: #,0
		displayFolder: KPIs
		lineageTag: cfb26203-b09c-4f3c-821f-e511d7c7d74b

	measure 'Average Daily Rate' = DIVIDE([Total Revenue], [Occupied Room Nights])
		formatString: #,0.00 " CU"
		displayFolder: KPIs
		lineageTag: ee80add1-0d1c-4ffc-a7f0-527559b174de

	measure 'Average Length of Stay' = DIVIDE([Occupied Room Nights], [Completed Bookings])
		formatString: 0.00
		displayFolder: KPIs
		lineageTag: 02f254a7-49db-4d89-902d-6e994241cb6d

	measure 'Revenue Previous Month' = IF(HASONEVALUE(DimDate[year_month]), CALCULATE([Total Revenue], DATEADD(DimDate[date], -1, MONTH)))
		formatString: #,0.00 " CU"
		displayFolder: KPIs
		lineageTag: 4c32ff09-4e2f-4a57-bc7b-f9657878478c

	measure 'Revenue Month-over-Month %' = DIVIDE([Total Revenue] - [Revenue Previous Month], [Revenue Previous Month])
		formatString: 0.00%
		displayFolder: KPIs
		lineageTag: c6b98d06-4e28-40e0-b189-166eea9116e4

	measure 'Revenue Previous Year' = IF(HASONEVALUE(DimDate[year_month]), CALCULATE([Total Revenue], DATEADD(DimDate[date], -1, YEAR)))
		formatString: #,0.00 " CU"
		displayFolder: KPIs
		lineageTag: 7be007f9-40f0-4aac-a440-eabad5f67056

	measure 'Revenue Year-over-Year %' = DIVIDE([Total Revenue] - [Revenue Previous Year], [Revenue Previous Year])
		formatString: 0.00%
		displayFolder: KPIs
		lineageTag: 03e525fd-cf76-4fba-9c33-a591e7998446

	measure 'Repeat Customer Rate' =
			VAR CustomersWithStays =
			    ADDCOLUMNS(VALUES(FactBookings[customer_id]), "StayCount", CALCULATE([Completed Bookings]))
			VAR Eligible = COUNTROWS(FILTER(CustomersWithStays, [StayCount] >= 1))
			VAR Repeaters = COUNTROWS(FILTER(CustomersWithStays, [StayCount] > 1))
			RETURN DIVIDE(Repeaters, Eligible)
		formatString: 0.00%
		displayFolder: KPIs
		lineageTag: 29570c3c-d715-4c9f-9a68-5d1b12f91d24

	measure 'Booking Demand' =
			CALCULATE([Total Bookings],
			    CROSSFILTER(DimDate[date], FactBookings[check_in_date], NONE),
			    USERELATIONSHIP(DimDate[date], FactBookings[booking_date]))
		formatString: #,0
		displayFolder: KPIs
		lineageTag: bd450692-e984-49db-8323-a3394c3e6371

	measure 'Average Lead Time' = AVERAGE(FactBookings[lead_time_days])
		formatString: 0.00
		displayFolder: KPIs
		lineageTag: 013b794c-114d-446f-a11b-d78e6c45dcbc

	measure 'No Show Bookings' = CALCULATE([Total Bookings], KEEPFILTERS(FactBookings[booking_status] = "No Show"))
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 13dd83c1-c778-48f7-b3d8-523272fe9508

	measure 'Top Five Hotel Revenue' = IF(RANKX(ALLSELECTED(DimHotels[hotel_name]), [Total Revenue], , DESC, DENSE) <= 5, [Total Revenue])
		formatString: #,0.00 " CU"
		displayFolder: KPIs
		lineageTag: fe5445b3-f550-4b26-907e-0e425ad1b2cd

	measure 'Top Ten Hotel Profit' = IF(RANKX(ALLSELECTED(DimHotels[hotel_name]), [Total Profit], , DESC, DENSE) <= 10, [Total Profit])
		formatString: #,0.00 " CU"
		displayFolder: KPIs
		lineageTag: 8ee172f2-3be5-47e4-bb7d-d52c29324ded

	measure 'Completed Customers' = CALCULATE(DISTINCTCOUNT(FactBookings[customer_id]), KEEPFILTERS(FactBookings[booking_status] = "Completed"))
		formatString: #,0
		displayFolder: KPIs
		lineageTag: e5ab35f0-b237-48df-8ccd-6cbc202400c0

	measure 'Repeat Customers' = COUNTROWS(FILTER(VALUES(FactBookings[customer_id]), [Completed Bookings] > 1))
		formatString: #,0
		displayFolder: KPIs
		lineageTag: e02b1ea8-10da-4927-8bbd-c50a47ff0781

