	partition FactBookings = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(pDataFolder & "/bookings.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Bands = Table.AddColumn(Nulls, "lead_time_band", each if Number.FromText([lead_time_days])<7 then "00-06" else if Number.FromText([lead_time_days])<14 then "07-13" else if Number.FromText([lead_time_days])<30 then "14-29" else "30+", type text),
				    Typed = Table.TransformColumnTypes(Bands, {{"booking_id", type text}, {"customer_id", type text}, {"hotel_id", type text}, {"channel_id", Int64.Type}, {"booking_date", type date}, {"check_in_date", type date}, {"check_out_date", type date}, {"room_type", type text}, {"booking_channel", type text}, {"booking_status", type text}, {"number_of_guests", Int64.Type}, {"number_of_nights", Int64.Type}, {"lead_time_days", Int64.Type}, {"customer_segment", type text}, {"source_country", type text}, {"room_rate", Currency.Type}, {"room_rate_cents", Int64.Type}, {"discount_amount", Currency.Type}, {"discount_amount_cents", Int64.Type}, {"revenue", Currency.Type}, {"revenue_cents", Int64.Type}, {"estimated_cost", Currency.Type}, {"estimated_cost_cents", Int64.Type}, {"profit", Currency.Type}, {"profit_cents", Int64.Type}, {"total_booking_amount", Currency.Type}, {"total_booking_amount_cents", Int64.Type}, {"lead_time_band", type text}}, "en-US")
				in
				    Typed

