	partition DimHotels = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(pDataFolder & "/hotels.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Nulls, {{"hotel_name", type text}, {"region", type text}, {"hotel_id", type text}, {"city", type text}, {"country", type text}, {"hotel_category", type text}}, "en-US")
				in
				    Typed

